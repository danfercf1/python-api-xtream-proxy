# =============================================================================
# SECURITY WARNING: Change ALL default passwords before deploying to production!
# Generate strong passwords with: openssl rand -base64 32
# =============================================================================

# Database Configuration
# MYSQL_ROOT_PASSWORD: Use a strong random password (min 20 characters)
# Generate: openssl rand -base64 32
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD_32_CHARS_MIN
MYSQL_HOST=mariadb
# MYSQL_USER: Use a non-obvious username (not 'root', 'admin', 'xtream_code')
MYSQL_USER=dbuser_X7k9mP2q
# MYSQL_PASSWORD: Use a strong random password (min 20 characters)
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD_32_CHARS_MIN
MYSQL_DATABASE=xtream_code
PORT=80
DEBUG=false
SERVER_IP=server.latinotvonline.xyz

# Upstream Gateway Credentials (for fetching from parent Xtream server)
# These are YOUR credentials to access the upstream provider
# USERNAME: Your Xtream username
USERNAME=your_xtream_username
# PASSWORD: Your Xtream password (plaintext required for Xtream API)
PASSWORD=your_xtream_password

# --- Security / Audit Settings ---
# Enable audit logging for authentication events (default: true)
AUDIT_LOG_ENABLED=true

# --- Proxy Mode (IMPORTANT: Credential Visibility) ---
# Xtream Codes API requires credentials in URL parameters. This means:
# 1. Credentials are visible in server logs (both yours and upstream)
# 2. Credentials are visible in browser history/player logs
# 3. Credentials are visible in network traffic
#
# PROXY_MODE_ENABLED: When true, gateway PROXIES requests to upstream instead of 
# redirecting (302). This hides the upstream URL from clients but increases 
# bandwidth usage on your gateway server.
#
# Trade-offs:
# - PROXY_MODE_ENABLED=false (default): 
#     * Client sees redirect to upstream URL with credentials
#     * Credentials visible in client logs/history
#     * Lower bandwidth usage on gateway
#     * Standard Xtream Codes behavior
#
# - PROXY_MODE_ENABLED=true:
#     * Client only sees gateway URL
#     * Credentials hidden from client (still visible gateway-upstream)
#     * Higher bandwidth usage (streams pass through gateway)
#     * May impact performance for high-traffic streams
#
# RECOMMENDATION: Enable for API endpoints (player_api.php, get.php, xmltv.php)
# Disable for stream segments (ts files) to avoid bandwidth overload
PROXY_MODE_ENABLED=false

# --- Password Encryption ---
# Enable encryption for passwords stored in database (default: true)
# When enabled, user passwords are encrypted at rest using Fernet symmetric encryption
ENABLE_PASSWORD_ENCRYPTION=true
# Encryption key for password encryption (required if encryption is enabled)
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANT: Keep this key secret and back it up! Lost keys cannot decrypt existing passwords!
ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_FERNET

# --- Bot mitigation / proxy settings ---
# Requests per minute per IP for /player_api.php (set lower if you're being flooded)
RATE_LIMIT_PLAYER_API_PER_MINUTE=30
# Requests per minute per IP for the catch-all redirect route
RATE_LIMIT_REDIRECT_PER_MINUTE=120
# Only set true if running behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_PROXY_HEADERS=false

# --- Upstream request profile (to mimic IPTV apps like TiviMate) ---
UPSTREAM_USER_AGENT="Mozilla/5.0 (Linux; Android 11) AppleWebKit/537.36 (KHTML, like Gecko) Version/4.0 Chrome/120.0 Mobile Safari/537.36"
UPSTREAM_TIMEOUT_SECONDS=20

# Sync scripts: disable playlist fallback by default.
# Set to 1 only if you want sync to fall back to get.php when player_api.php is blocked.
ENABLE_M3U_FALLBACK=0

# Sync streams cleaning: remove fake "category header" rows (e.g. ###### ECUADOR ######)
STREAM_SKIP_NAME_REGEX=^#+\\s*.+\\s*#+$

# --- SSL/TLS Configuration ---
# Verify SSL certificates when connecting to upstream servers (default: false)
# WARNING: Setting to true may break compatibility with some Xtream Codes providers
# that use self-signed certificates. Only enable if your provider uses valid SSL.
SSL_VERIFY_UPSTREAM=false